# PostgreSQL target. Keep the real DSN in a private file outside the repository.
SODNAPRAKSA_DATABASE_URL=<required-postgresql-dsn>
SODNAPRAKSA_EXPECTED_DATABASE=<required-database-name>
SODNAPRAKSA_EXPECTED_SCHEMA=public
# Source API base ending in /api2 and the private source key.
SODNAPRAKSA_SOURCE_BASE_URL=<required-https-source-base-url-ending-in-api2>
SODNAPRAKSA_SOURCE_API_KEY=<required-source-api-key>
# Qdrant target. The API key is optional only for a target that requires none.
SODNAPRAKSA_QDRANT_URL=<required-qdrant-base-url>
SODNAPRAKSA_QDRANT_API_KEY=
SODNAPRAKSA_QDRANT_COLLECTION=sodnapraksa_current
# Embedding contract fixed by the current collection.
SODNAPRAKSA_EMBEDDING_BASE_URL=<required-https-embedding-base-url>
SODNAPRAKSA_EMBEDDING_API_KEY=<required-embedding-api-key>
SODNAPRAKSA_EMBEDDING_MODEL=text-embedding-3-large
SODNAPRAKSA_EMBEDDING_DIMENSIONS=3072
# Writable paths owned by the service account.
SODNAPRAKSA_CHECKPOINT_PATH=/var/lib/sodnapraksa-ingest/checkpoint.json
SODNAPRAKSA_LOCK_PATH=/run/sodnapraksa-ingest/ingest.lock
# Select and review the first UTC boundary before the first mutating run.
SODNAPRAKSA_INITIAL_SINCE=<required-utc-iso8601-timestamp>
# Reviewed reference limits. Change them only after measuring the intended interval.
SODNAPRAKSA_OVERLAP_DAYS=7
SODNAPRAKSA_DISCOVERY_LIMIT=5000
SODNAPRAKSA_DOCUMENT_LIMIT=350
SODNAPRAKSA_MAX_EMBEDDING_INPUT_BYTES_PER_RUN=2000000
# Keep both gates closed during setup and read-only preflight.
SODNAPRAKSA_ALLOW_EXTERNAL_API=0
SODNAPRAKSA_ALLOW_WRITES=0
