# Replace every required placeholder in a root-only file outside the repository.
SODNAPRAKSA_DATABASE_URL=<required-postgresql-dsn>
SODNAPRAKSA_EXPECTED_DATABASE=<required-database-name>
SODNAPRAKSA_EXPECTED_SCHEMA=<required-schema-name>
SODNAPRAKSA_SOURCE_BASE_URL=<required-https-source-base-url>
SODNAPRAKSA_SOURCE_API_KEY=<required-source-api-key>
SODNAPRAKSA_QDRANT_URL=<required-qdrant-base-url>
SODNAPRAKSA_QDRANT_API_KEY=
SODNAPRAKSA_QDRANT_COLLECTION=<required-collection-name>
SODNAPRAKSA_EMBEDDING_BASE_URL=<required-https-embedding-base-url>
SODNAPRAKSA_EMBEDDING_API_KEY=<required-embedding-api-key>
SODNAPRAKSA_EMBEDDING_MODEL=<required-embedding-model>
SODNAPRAKSA_EMBEDDING_DIMENSIONS=<required-positive-integer>
SODNAPRAKSA_CHECKPOINT_PATH=/var/lib/sodnapraksa-ingest/checkpoint.json
SODNAPRAKSA_LOCK_PATH=/run/sodnapraksa-ingest/ingest.lock
SODNAPRAKSA_INITIAL_SINCE=<required-utc-iso8601-timestamp>
SODNAPRAKSA_OVERLAP_DAYS=<required-positive-integer>
SODNAPRAKSA_DISCOVERY_LIMIT=<required-positive-integer>
SODNAPRAKSA_DOCUMENT_LIMIT=<required-positive-integer>
SODNAPRAKSA_MAX_EMBEDDING_INPUT_BYTES_PER_RUN=<required-positive-integer>
SODNAPRAKSA_ALLOW_EXTERNAL_API=<required-0-or-1>
SODNAPRAKSA_ALLOW_WRITES=<required-0-or-1>
